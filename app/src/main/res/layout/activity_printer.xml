<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖨 AI + Принтер"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <TextView
            android:id="@+id/tvPrinter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🖨 Принтер не подключён"
            android:textSize="14sp"
            android:gravity="center"
            android:paddingBottom="8dp"/>

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔗 Подключить принтер"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Нажмите 🎤 для начала"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="12dp"/>

        <Button
            android:id="@+id/btnMic"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:text="🎤"
            android:textSize="40sp"
            android:background="@drawable/mic_button_bg"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Скажи «напечатай» — ответ уйдёт на принтер"
            android:textSize="13sp"
            android:gravity="center"
            android:paddingBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Твой вопрос:"
            android:textStyle="bold"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/tvTranscript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textIsSelectable="true"
            android:padding="10dp"
            android:minHeight="60dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ответ ИИ:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:paddingTop="12dp"/>

        <TextView
            android:id="@+id/tvResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textIsSelectable="true"
            android:padding="10dp"
            android:minHeight="100dp"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Настройки"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
